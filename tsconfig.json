{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "./next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "lib/registry-item.ts",
    "lib/registry.ts",
    "registry/registry.ts",
    "registry/bases.ts",
    "registry/**/registry.ts",
    "registry/**/_registry.ts",
    "registry/**/_components-registry.ts",
    "registry/core/_*.ts",
    "scripts/**/*.mjs",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "registry/**/*.tsx"
  ]
}
