{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "app/globals.css",
    "baseColor": "zinc",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "aliases": {
    "app": "@/app",
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks",
    "types": "@/types",
    "content": "@/content"
  },
  "registries": {
    "@tailark-oss": "https://oss.tailark.com/r/{name}.json",
    "@tailark": {
      "url": "https://tailark.com/r/{name}.json",
      "headers": {
        "x-api-key": "${TAILARK_API_KEY}"
      }
    },
    "@svgl": "https://svgl.app/r/{name}.json"
  }
}
